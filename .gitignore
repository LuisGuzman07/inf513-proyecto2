/.mimocode/
**/node_modules/
**/vendor/
**/.env
**/.env.*
!**/.env.example
**/dist/
**/coverage/
**/storybook-static/
**/*.tsbuildinfo
**/.DS_Store
/backend/storage/logs/*
!/backend/storage/logs/.gitignore
# Local inspection artifacts, never part of the project
/.playwright-mcp/
/identity-uagrm-observed.png
# Local-only state, diagnostics and generated outputs
/.impeccable/
/graphify-out/
**/*.log
**/*.tmp
**/*.temp
**/.cache/
**/test-results/
**/playwright-report/
**/blob-report/
**/.pytest_cache/
**/__pycache__/

# Credentials and database copies (examples remain versioned above)
**/auth.json
**/credentials.json
**/credentials.*.json
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/id_rsa*
**/id_ed25519*
**/*.sqlite
**/*.sqlite3
**/*.sqlite-wal
**/*.sqlite-shm
**/*.dump
**/*.backup

# Runtime data: keep only Laravel's empty-directory placeholders
/backend/bootstrap/cache/*
!/backend/bootstrap/cache/.gitignore
/backend/storage/**
!/backend/storage/**/
!/backend/storage/**/.gitignore
/backend/public/storage
/backend/public/hot
/backend/public/build/
**/uploads/

# External/private materials and private verification must never enter Git
/resources/
/sources/
/private/
/docs/private/
/docs/verification-captures/**/private*/
/docs/verification-captures/**/habil*.png
/docs/verification-captures/**/*clave*.png
/docs/verification-captures/**/*resultado*staff*.png

# Transfer bundles and archives remain local; sources/docs are recorded individually
**/*.zip
**/*.rar
**/*.7z
**/*.tar
**/*.tgz
**/*.gz
# Historical screenshot batches stay local. Keep the approved visual cuts only.
/docs/verification-captures/**/*.json
